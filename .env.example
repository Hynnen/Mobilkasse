# Kopier til .env.local og fyll inn. .env.local skal aldri committes.

# Butikk / profil
STORE_NAME="Min butikk"
STORE_SHORT_NAME="Kasse"
STORE_THEME_COLOR="#111111"
# Valgfri: full https-URL til logo
STORE_LOGO_URL=""

# WooCommerce
# Uten /wp-json, må være https
WOO_URL="https://example.no"
WOO_CONSUMER_KEY="ck_..."
WOO_CONSUMER_SECRET="cs_..."
# Valgfri: slug på kategori ELLER tagg som skal vises i kassen
WOO_POS_CATEGORY=""
# auto | header | query  (auto prøver Basic auth først, så query-parametre)
WOO_AUTH_MODE="auto"

# Innlogging
# 4–8 sifre
POS_PIN="1234"
# Minst 32 tegn, f.eks. `openssl rand -hex 32`
SESSION_SECRET=""
